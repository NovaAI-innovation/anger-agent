# ============================================================================
# Agent Framework - Global Configuration
# ============================================================================
#
# Purpose: Default framework-level environment variables
#
# Usage:
#   1. Copy this file to .env (in the same directory)
#   2. Edit .env with your custom values
#   3. All agents can access these as defaults
#
# Note:
#   - Individual agents can override these in their own .env files
#   - Do not commit .env file (already in .gitignore)
#
# ============================================================================

# ============================================================================
# DEFAULT PATHS
# ============================================================================
# Default data directories used by all agents if not overridden

# Default data directory for all agents
AGENT_DATA_DIR=./data

# Default logs directory for all agents
AGENT_LOGS_DIR=./logs

# ============================================================================
# DEFAULT LOGGING
# ============================================================================

# Global default log level (debug, info, warning, error)
# Can be overridden in individual agent .env files
LOG_LEVEL=info

# ============================================================================
# PYTHON CONFIGURATION
# ============================================================================

# Python module path (for custom tools and modules)
PYTHONPATH=.

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Enable debug mode for all agents
# DEBUG=false

# Environment: dev, staging, production
# ENVIRONMENT=dev

# ============================================================================
# FRAMEWORK FEATURES (v0.2+)
# ============================================================================

# Hub connectivity (v0.5 feature)
# HUB_ENABLED=false
# HUB_ENDPOINT=ws://localhost:8000

# ============================================================================
# PROVIDER DEFAULTS (for LLM agents)
# ============================================================================

# Default LLM provider: mock, openai, claude
# LLM_PROVIDER=mock

# Timeout for LLM requests (seconds)
# LLM_TIMEOUT=30
