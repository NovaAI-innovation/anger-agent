# ============================================================================
# Document Categorizer Agent - Configuration
# ============================================================================
#
# Purpose: Define environment variables for the document categorizer agent
#
# Usage:
#   1. Copy this file to .env (in the same directory)
#   2. Edit .env with your configuration
#   3. The agent will read these values automatically
#
# Note:
#   - Relative paths (./data/inbox) work on Windows and Linux
#   - Absolute paths use native format (C:\data or /home/user/data)
#   - Do not commit .env file - it contains local paths and API keys
#
# ============================================================================

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
# Where documents come in and are routed based on category
#
# Option A: Relative paths (Recommended - works everywhere)
AGENT_INBOX_PATH=./data/inbox
AGENT_PROCESSED_PATH=./data/processed
AGENT_ERRORS_PATH=./data/errors
AGENT_REVIEW_PATH=./data/review

# Option B: Absolute paths (if you need files in a specific location)
# Windows example:
#   AGENT_INBOX_PATH=C:\Users\YourName\documents\inbox
#   AGENT_PROCESSED_PATH=C:\Users\YourName\documents\processed
#   AGENT_ERRORS_PATH=C:\Users\YourName\documents\errors
#   AGENT_REVIEW_PATH=C:\Users\YourName\documents\review
#
# Linux example:
#   AGENT_INBOX_PATH=/home/user/documents/inbox
#   AGENT_PROCESSED_PATH=/home/user/documents/processed
#   AGENT_ERRORS_PATH=/home/user/documents/errors
#   AGENT_REVIEW_PATH=/home/user/documents/review

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Choose which LLM provider to use for document categorization
#
# Options: mock, openai, claude
# Default: mock (fast, deterministic, no API key needed)

# Provider type: mock | openai | claude
LLM_PROVIDER=mock

# ============================================================================
# OPENAI PROVIDER (Only needed if LLM_PROVIDER=openai)
# ============================================================================
# Required: OpenAI API key
# Get key: https://platform.openai.com/account/api-keys
#
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo

# ============================================================================
# ANTHROPIC PROVIDER (Only needed if LLM_PROVIDER=claude)
# ============================================================================
# Required: Anthropic API key
# Get key: https://console.anthropic.com/account/keys
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: debug, info, warning, error
LOG_LEVEL=debug

# Where to write logs (relative or absolute)
LOG_FILE=./logs/document_categorizer.log

# Maximum log file size in MB (before rotation)
LOG_MAX_SIZE_MB=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================================================
# DOCUMENT CATEGORIZER SETTINGS
# ============================================================================

# Categorization confidence threshold (0.0-1.0)
# Documents below this threshold go to review folder
MIN_CONFIDENCE=0.7

# Document size limit in KB (0 = no limit)
MAX_DOCUMENT_SIZE_KB=10000

# ============================================================================
# FOR DEVELOPERS
# ============================================================================

# Python path (if using custom modules)
PYTHONPATH=.

# Debug mode (verbose output)
# DEBUG=false

# Timeout for LLM requests (seconds)
# LLM_TIMEOUT_SECONDS=30
