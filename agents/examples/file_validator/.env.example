# ============================================================================
# File Validator Agent - Configuration
# ============================================================================
#
# Purpose: Define environment variables for the file validator agent
#
# Usage:
#   1. Copy this file to .env (in the same directory)
#   2. Edit .env with your custom paths
#   3. The agent will read these values automatically
#
# Note:
#   - Relative paths (./data/inbox) work on Windows and Linux
#   - Absolute paths use native format (C:\data or /home/user/data)
#   - Do not commit .env file - it contains local paths
#   - Windows and Linux both support forward slashes (/)
#
# ============================================================================

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
# Where files come in, go out, and errors are logged
#
# Option A: Relative paths (Recommended - works everywhere)
AGENT_INBOX_PATH=./data/inbox
AGENT_PROCESSED_PATH=./data/processed
AGENT_ERRORS_PATH=./data/errors

# Option B: Absolute paths (if you need files in a specific location)
# Windows example:
#   AGENT_INBOX_PATH=C:\Users\YourName\agent_files\inbox
#   AGENT_PROCESSED_PATH=C:\Users\YourName\agent_files\processed
#   AGENT_ERRORS_PATH=C:\Users\YourName\agent_files\errors
#
# Linux example:
#   AGENT_INBOX_PATH=/home/user/agent_files/inbox
#   AGENT_PROCESSED_PATH=/home/user/agent_files/processed
#   AGENT_ERRORS_PATH=/home/user/agent_files/errors

# Schema validation file location
SCHEMA_PATH=./schema.json

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: debug, info, warning, error
LOG_LEVEL=info

# Where to write logs (relative or absolute)
LOG_FILE=./logs/file_validator.log

# Maximum log file size in MB (before rotation)
LOG_MAX_SIZE_MB=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================================================
# MONITORING (Optional)
# ============================================================================

# Enable performance monitoring
MONITORING_ENABLED=true

# ============================================================================
# FOR DEVELOPERS
# ============================================================================

# Python path (if using custom modules)
PYTHONPATH=.

# Debug mode (verbose output)
# DEBUG=false
