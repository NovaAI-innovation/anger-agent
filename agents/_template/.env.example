# ============================================================================
# Agent Configuration Template
# ============================================================================
#
# Purpose: Define environment variables for your agent
#
# Usage:
#   1. Copy this file to .env (in the same directory)
#   2. Edit .env with your custom values
#   3. The agent will read these values automatically
#
# Note:
#   - Relative paths (./data/inbox) work on Windows and Linux
#   - Absolute paths use native format (C:\data or /home/user/data)
#   - Do not commit .env file - it contains local paths and secrets
#
# ============================================================================

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
# Configure where your agent processes files

# Input directory for incoming files
AGENT_INBOX_PATH=./data/inbox

# Output directory for successfully processed files
AGENT_PROCESSED_PATH=./data/processed

# Error directory for files that failed processing
AGENT_ERRORS_PATH=./data/errors

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: debug, info, warning, error
LOG_LEVEL=info

# Where to write logs (relative or absolute)
LOG_FILE=./logs/agent.log

# Maximum log file size in MB (before rotation)
LOG_MAX_SIZE_MB=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================================================
# AGENT-SPECIFIC SETTINGS
# ============================================================================
# Add your own environment variables here
#
# Examples:
# SCHEMA_PATH=./schema.json
# DATABASE_URL=sqlite:///agent.db
# API_TIMEOUT=30
# ENABLE_VALIDATION=true

# ============================================================================
# FOR DEVELOPERS
# ============================================================================

# Python path (if using custom modules)
PYTHONPATH=.

# Debug mode (verbose output)
# DEBUG=false
